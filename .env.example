# Copy to apps/api/.env for local development. Never commit the real file.
# Production: use .env.production.example → .env.production (see docs/deploy/production.md).

# --- Core ---
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5173
# Reverse-proxy hops to trust for client IPs: 1 behind Nginx/Caddy, 0 when the API is exposed directly
TRUST_PROXY=0
LOG_FORMAT=text

# --- Database (PostgreSQL) ---
DATABASE_URL=postgresql://ai_company:local_dev_only@localhost:5432/ai_company?schema=public
# Separate database for e2e tests — it is wiped on every run. Its name must contain "test".
TEST_DATABASE_URL=postgresql://ai_company:local_dev_only@localhost:5432/ai_company_test?schema=public

# --- Redis (BullMQ for lead-source scan jobs; without it, scans run inline in the API) ---
REDIS_URL=redis://localhost:6379

# --- Auth ---
# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=8h

# --- Initial CEO account (used only by `npm run db:seed`) ---
CEO_EMAIL=
CEO_NAME=
# At least 12 characters. Change it after first login if you share this file anywhere.
CEO_PASSWORD=

# --- Limits / monitoring ---
TASK_DEFAULT_MAX_ATTEMPTS=3
SCAN_JOB_ATTEMPTS=2
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Optional estimated USD/day alert threshold (not invoices)
AI_DAILY_ESTIMATED_USD_BUDGET=
SHUTDOWN_TIMEOUT_MS=15000

# --- AI provider (OpenAI SDK; works with OpenRouter too) ---
# Key stays on the server. For OpenRouter: paste your sk-or-... key and set BASE_URL below.
OPENAI_API_KEY=
# Leave empty for api.openai.com. OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=
# Economical / free model ID. Prefer OpenRouter auto-router (slugs go offline often):
#   openrouter/free
# Or a current free model from https://openrouter.ai/models?max_price=0
OPENAI_MODEL=
# Optional stronger model for difficult tasks (falls back to OPENAI_MODEL)
OPENAI_MODEL_ADVANCED=

# --- Email (Resend) — CEO-authorized mailbox only; leave empty to disable live send ---
# Docs: https://resend.com/docs/send-with-nodejs
EMAIL_PROVIDER=
RESEND_API_KEY=
# Must be a verified domain/address in Resend (the CEO's authorized from-address)
EMAIL_FROM=
EMAIL_REPLY_TO=
# Optional: shared secret checked on POST /api/webhooks/email/inbound
RESEND_WEBHOOK_SECRET=

# --- Reddit lead source (official API; free app) ---
# Create an app at https://www.reddit.com/prefs/apps → "create another app…"
#   type: script (or web app). Copy the client id under the app name and the secret.
# Leave empty to keep Reddit unauthorized (Import-only platforms still work via CSV).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: user oauth refresh token. When unset, application-only client_credentials is used.
REDDIT_REFRESH_TOKEN=
# Optional: descriptive User-Agent Reddit requires (defaults to ai-company-hq/…).
REDDIT_USER_AGENT=

# LinkedIn / Facebook / Indeed as LEAD SOURCES: free path is CSV import on Sources (no live scrape).
# Never put personal login passwords here — company accounts connect through official OAuth below.

# --- Social OAuth connections (Control Center → Social connections) ---
# Browser origin the app is opened at. OAuth redirect URIs are <PUBLIC_APP_URL>/api/social/<platform>/callback
# and must be registered EXACTLY in each platform's developer console. Must match the address you use.
PUBLIC_APP_URL=http://localhost:5173
# Encrypts OAuth tokens at rest (AES-256-GCM). Optional in development (derived from JWT_SECRET when empty). Generate: openssl rand -base64 32
# Keep it stable: changing it makes stored tokens unreadable (you would have to reconnect).
TOKEN_ENCRYPTION_KEY=
# LinkedIn: https://www.linkedin.com/developers/apps  (products: Sign In with LinkedIn using OpenID Connect + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_SCOPES=openid profile email w_member_social
# Facebook: https://developers.facebook.com/apps (Facebook Login for Business). pages_* need Meta App Review for non-admins.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v26.0
# FACEBOOK_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts
# Reddit uses REDDIT_CLIENT_ID / REDDIT_CLIENT_SECRET (app type must be "web app" for the Connect button).
# REDDIT_SCOPES=identity read submit
# X: https://developer.x.com — OAuth 2.0, type "Web App"; use the OAuth 2.0 Client ID/Secret (not API key).
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_SCOPES=tweet.read tweet.write users.read offline.access
