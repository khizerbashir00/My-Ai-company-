# Production secrets template. Copy to `.env.production` on the server (never commit).
#   cp .env.production.example .env.production
# Generate secrets:  openssl rand -base64 48

# --- Public hostname (DNS A/AAAA must point here before TLS can issue) ---
HQ_DOMAIN=hq.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Postgres (compose-internal; change the password) ---
POSTGRES_USER=ai_company
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=ai_company

# --- API ---
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
TRUST_PROXY=1
# Browser origin (usually https://HQ_DOMAIN). Comma-separated if you need extras.
CORS_ORIGINS=https://hq.example.com
LOG_FORMAT=json
RUN_MIGRATIONS_ON_START=1
SHUTDOWN_TIMEOUT_MS=15000

# Task / job limits
TASK_DEFAULT_MAX_ATTEMPTS=3
SCAN_JOB_ATTEMPTS=2
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Optional: notify CEO when today's estimated AI USD exceeds this (ESTIMATE, not invoice)
AI_DAILY_ESTIMATED_USD_BUDGET=

# --- Optional integrations (leave empty until ready) ---
OPENAI_API_KEY=
# OpenRouter: https://openrouter.ai/api/v1  (empty = official OpenAI)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_MODEL_ADVANCED=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# --- Bootstrap seed only (run once manually; not used by compose by default) ---
# CEO_EMAIL=
# CEO_NAME=
# CEO_PASSWORD=
# ALLOW_PROD_SEED=1
