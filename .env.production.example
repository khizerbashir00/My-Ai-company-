# Production secrets template. Copy to `.env.production` on the server (never commit).
#   cp .env.production.example .env.production
# Generate secrets:  openssl rand -base64 48

# --- Public hostname (DNS A/AAAA must point here before TLS can issue) ---
HQ_DOMAIN=hq.example.com
HTTP_PORT=80
HTTPS_PORT=443

# --- Postgres (compose-internal; change the password) ---
POSTGRES_USER=ai_company
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=ai_company

# --- API ---
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
TRUST_PROXY=1
# Browser origin (usually https://HQ_DOMAIN). Comma-separated if you need extras.
CORS_ORIGINS=https://hq.example.com
LOG_FORMAT=json
RUN_MIGRATIONS_ON_START=1
SHUTDOWN_TIMEOUT_MS=15000

# Task / job limits
TASK_DEFAULT_MAX_ATTEMPTS=3
SCAN_JOB_ATTEMPTS=2
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120
# Optional: notify CEO when today's estimated AI USD exceeds this (ESTIMATE, not invoice)
AI_DAILY_ESTIMATED_USD_BUDGET=

# --- Optional integrations (leave empty until ready) ---
OPENAI_API_KEY=
# OpenRouter: https://openrouter.ai/api/v1  (empty = official OpenAI)
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_MODEL_ADVANCED=
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
RESEND_WEBHOOK_SECRET=

# Reddit official API (optional; https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REFRESH_TOKEN=
REDDIT_USER_AGENT=

# --- Social OAuth connections (Control Center → Social connections) ---
# Browser origin the app is opened at. OAuth redirect URIs are <PUBLIC_APP_URL>/api/social/<platform>/callback
# and must be registered EXACTLY in each platform's developer console. Must match the address you use.
PUBLIC_APP_URL=https://hq.example.com
# Encrypts OAuth tokens at rest (AES-256-GCM). REQUIRED for social connections in production. Generate: openssl rand -base64 32
# Keep it stable: changing it makes stored tokens unreadable (you would have to reconnect).
TOKEN_ENCRYPTION_KEY=
# LinkedIn: https://www.linkedin.com/developers/apps  (products: Sign In with LinkedIn using OpenID Connect + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_SCOPES=openid profile email w_member_social
# Facebook: https://developers.facebook.com/apps (Facebook Login for Business). pages_* need Meta App Review for non-admins.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v26.0
# FACEBOOK_SCOPES=public_profile,pages_show_list,pages_read_engagement,pages_manage_posts
# Reddit uses REDDIT_CLIENT_ID / REDDIT_CLIENT_SECRET (app type must be "web app" for the Connect button).
# REDDIT_SCOPES=identity read submit
# X: https://developer.x.com — OAuth 2.0, type "Web App"; use the OAuth 2.0 Client ID/Secret (not API key).
X_CLIENT_ID=
X_CLIENT_SECRET=
# X_SCOPES=tweet.read tweet.write users.read offline.access

# --- Bootstrap seed only (run once manually; not used by compose by default) ---
# CEO_EMAIL=
# CEO_NAME=
# CEO_PASSWORD=
# ALLOW_PROD_SEED=1
