}

/// Company-wide CEO daily/weekly report from counted HQ metrics (not invented).
model CeoReport {
  id                String                @id @default(uuid()) @db.Uuid
  period            MarketingReportPeriod
  periodStart       DateTime              @map("period_start")
  periodEnd         DateTime              @map("period_end")
  title             String
  body              String                @default("")
  metricsSnapshot   Json                  @map("metrics_snapshot")
  generatedByUserId String?               @map("generated_by_user_id") @db.Uuid
  generatedAt       DateTime              @default(now()) @map("generated_at")

  generatedByUser User? @relation(fields: [generatedByUserId], references: [id], onDelete: SetNull)

  @@index([period, periodStart])
  @@index([generatedAt])
  @@map("ceo_reports")
}

// ─────────────────────────────── Governance ───────────────────────────────

model Approval {
  id                 String             @id @default(uuid()) @db.Uuid
  actionType         ApprovalActionType @map("action_type")
  status             ApprovalStatus     @default(PENDING)
  /// What will be affected, e.g. entityType="outreach_message"
  entityType         String             @map("entity_type")
  entityId           String?            @map("entity_id")
  summary            String
  /// Exact action payload that will execute on approval (validated again at execution time)
  payload            Json?
  requestedByAgentId String?            @map("requested_by_agent_id") @db.Uuid
  taskId             String?            @map("task_id") @db.Uuid
  decidedById        String?            @map("decided_by_id") @db.Uuid
  decidedAt          DateTime?          @map("decided_at")
  decisionNote       String?            @map("decision_note")
  expiresAt          DateTime?          @map("expires_at")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  requestedByAgent AgentDefinition? @relation(fields: [requestedByAgentId], references: [id], onDelete: SetNull)
  task             Task?            @relation(fields: [taskId], references: [id], onDelete: SetNull)
  decidedBy        User?            @relation("ApprovalDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([entityType, entityId])
  @@map("approvals")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  type      NotificationType
  title     String
  body      String           @default("")
  link      String?
  /// One notification per (user, event): prevents duplicates
  dedupeKey String           @map("dedupe_key")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt])
  @@map("notifications")
}

enum TeamMessageAuthor {
  USER
  AGENT
}

/// One conversation between the CEO and a single AI teammate.
model TeamThread {
  id              String   @id @default(uuid()) @db.Uuid
  agentId         String   @map("agent_id") @db.Uuid
  createdByUserId String   @map("created_by_user_id") @db.Uuid
  subject         String   @default("")
  lastMessageAt   DateTime @default(now()) @map("last_message_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agent     AgentDefinition @relation(fields: [agentId], references: [id], onDelete: Cascade)
  createdBy User            @relation("TeamThreadCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  messages  TeamMessage[]

  @@unique([agentId, createdByUserId])
  @@index([lastMessageAt])
  @@map("team_threads")
}

model TeamMessage {
  id         String            @id @default(uuid()) @db.Uuid
  threadId   String            @map("thread_id") @db.Uuid
  authorKind TeamMessageAuthor @map("author_kind")
  userId     String?           @map("user_id") @db.Uuid
  agentId    String?           @map("agent_id") @db.Uuid
  body       String
  /// Optional link to the task that prompted this update (work report-back).
  taskId     String?           @map("task_id") @db.Uuid
  createdAt  DateTime          @default(now()) @map("created_at")

  thread TeamThread      @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user   User?           @relation("TeamMessageAuthor", fields: [userId], references: [id], onDelete: SetNull)
  agent  AgentDefinition? @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([threadId, createdAt])
  @@map("team_messages")
}

/// Development project created when the CEO confirms a deal. Development itself is done by the CEO.
model Project {
  id            String        @id @default(uuid()) @db.Uuid
  leadId        String?       @unique @map("lead_id") @db.Uuid
  name          String
  description   String        @default("")
  status        ProjectStatus @default(PLANNING)
  dealValue     Decimal       @map("deal_value") @db.Decimal(12, 2)
  currency      String        @default("USD")
  confirmedAt   DateTime      @default(now()) @map("confirmed_at")
  confirmedById String?       @map("confirmed_by_id") @db.Uuid
  startDate     DateTime?     @map("start_date")
  dueDate       DateTime?     @map("due_date")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  lead        Lead? @relation(fields: [leadId], references: [id], onDelete: SetNull)
  confirmedBy User? @relation("ProjectConfirmedBy", fields: [confirmedById], references: [id], onDelete: SetNull)

  @@index([confirmedAt])
  @@map("projects")
}

// ─────────────────────────────── Social connections ───────────────────────────────

enum SocialPlatform {
  LINKEDIN
  FACEBOOK
  REDDIT
  X
}

enum SocialAccountStatus {
  CONNECTED
  EXPIRED
  ERROR
}

/// One authorized account per platform for the company.
/// Tokens are AES-256-GCM encrypted at rest (TOKEN_ENCRYPTION_KEY) and never returned by the API.
model SocialAccount {
  id                String              @id @default(uuid()) @db.Uuid
  platform          SocialPlatform      @unique
  status            SocialAccountStatus @default(CONNECTED)
  /// Platform's own id for the authorized account
  externalAccountId String              @map("external_account_id")
  displayName       String              @map("display_name")
  profileUrl        String?             @map("profile_url")
  scopes            String[]            @default([])
  accessTokenEnc    String              @map("access_token_enc")
  refreshTokenEnc   String?             @map("refresh_token_enc")
  expiresAt         DateTime?           @map("expires_at")
  refreshExpiresAt  DateTime?           @map("refresh_expires_at")
  /// Non-secret extras (e.g. Facebook page names). Never tokens.
  metadata          Json?
  connectedById     String?             @map("connected_by_id") @db.Uuid
  connectedAt       DateTime            @default(now()) @map("connected_at")
  lastVerifiedAt    DateTime?           @map("last_verified_at")
  lastRefreshedAt   DateTime?           @map("last_refreshed_at")
  lastError         String?             @map("last_error")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@map("social_accounts")
}

/// Pending OAuth authorization (CSRF state + PKCE verifier). Single use, short-lived.
model OAuthState {
  id                String         @id @default(uuid()) @db.Uuid
  /// SHA-256 of the state value sent to the provider — the raw value is never stored
  stateHash         String         @unique @map("state_hash")
  platform          SocialPlatform
  userId            String         @map("user_id") @db.Uuid
  /// Encrypted PKCE code verifier (X); null for providers without PKCE
  codeVerifierEnc   String?        @map("code_verifier_enc")
  /// Continue the Connect All chain after the callback
  connectAll        Boolean        @default(false) @map("connect_all")
  expiresAt         DateTime       @map("expires_at")
  consumedAt        DateTime?      @map("consumed_at")
  createdAt         DateTime       @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

// ─────────────────────────────── Control center ───────────────────────────────

/// Persisted on/off switch for each background workflow, so Stop All survives restarts.
model WorkflowControl {
  key           String    @id
  isEnabled     Boolean   @map("is_enabled")
  updatedById   String?   @map("updated_by_id") @db.Uuid
  lastStartedAt DateTime? @map("last_started_at")
  lastStoppedAt DateTime? @map("last_stopped_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@map("workflow_controls")
}

enum ControlEventLevel {
  INFO
  WARN
  ERROR
}

/// Operations log for the Control Center (start/stop, recovery, worker results, OAuth results).
model ControlEvent {
  id          String            @id @default(uuid()) @db.Uuid
  level       ControlEventLevel @default(INFO)
  /// e.g. control.start_all, worker.task_completed, social.connected, recovery.task_failed
  action      String
  message     String
  data        Json?
  actorUserId String?           @map("actor_user_id") @db.Uuid
  createdAt   DateTime          @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("control_events")
}

/// Append-only. Who did what, when.
model AuditLog {
  id           String    @id @default(uuid()) @db.Uuid
  actorType    ActorType @map("actor_type")
  actorUserId  String?   @map("actor_user_id") @db.Uuid
  actorAgentId String?   @map("actor_agent_id") @db.Uuid
  action       String
  entityType   String?   @map("entity_type")
  entityId     String?   @map("entity_id")
  data         Json?
  ip           String?
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  actorUser  User?            @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAgent AgentDefinition? @relation(fields: [actorAgentId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@map("audit_logs")
}

model UsageRecord {
  id           String   @id @default(uuid()) @db.Uuid
  agentRunId   String?  @map("agent_run_id") @db.Uuid
  provider     String
  model        String
  inputTokens  Int      @default(0) @map("input_tokens")
  outputTokens Int      @default(0) @map("output_tokens")
  totalTokens  Int      @default(0) @map("total_tokens")
  createdAt    DateTime @default(now()) @map("created_at")

  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([provider, model])
  @@map("usage_records")
}
